---
import Base from '../layouts/Base.astro';
import { loadAllPapers } from '../lib/parsePapers';
import {
  SITE_TITLE,
  MAINTAINER_NAME,
  MAINTAINER_AFFILIATION,
  MAINTAINER_URL,
  REPO_URL,
} from '../lib/site';

const { canonical } = loadAllPapers();
const paperCount = canonical.length;
const lastYear = new Date().getFullYear();

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteOrigin = (Astro.site ?? new URL('https://human-ai-coevolution.github.io'))
  .toString()
  .replace(/\/$/, '');
const siteUrl = siteOrigin + base + '/';

const description = `A curated research index on human-AI coevolution: how humans must evolve to use AI well as AI advances. ${paperCount}+ papers organized by a four-phase framework (Tool, Assistant, Executor, Organization), a position paper, and a plain-language blog.`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': siteUrl + '#website',
    name: SITE_TITLE,
    url: siteUrl,
    description,
    inLanguage: 'en',
    potentialAction: {
      '@type': 'SearchAction',
      target: { '@type': 'EntryPoint', urlTemplate: `${siteOrigin}${base}/papers/?q={search_term_string}` },
      'query-input': 'required name=search_term_string',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Dataset',
    '@id': siteUrl + '#dataset',
    name: 'Human–AI Coevolution Paper Index',
    description: `A curated, openly maintained list of ${paperCount}+ research papers on how humans must evolve to use AI well as AI advances. Organized by a four-phase framework spanning Tool, Assistant, Executor, and Organization uses of AI.`,
    url: `${siteOrigin}${base}/papers/`,
    keywords: ['human-AI coevolution', 'human-AI collaboration', 'human-AI alignment', 'AI literacy', 'RLHF', 'mutual adaptation', 'longitudinal HCI', 'AI agents'],
    license: 'https://opensource.org/licenses/MIT',
    isAccessibleForFree: true,
    creator: { '@id': siteUrl + '#org' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': siteUrl + '#org',
    name: MAINTAINER_NAME,
    url: MAINTAINER_URL,
    parentOrganization: { '@type': 'EducationalOrganization', name: MAINTAINER_AFFILIATION },
  },
];

// Inline icons in the existing site's restrained style: thin stroke, currentColor.
const ICONS = {
  paper:    `<path d="M14 3v4a1 1 0 0 0 1 1h4"/><path d="M17 21H7a2 2 0 0 1 -2 -2V5a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2z"/><line x1="9" y1="13" x2="15" y2="13"/><line x1="9" y1="17" x2="13" y2="17"/>`,
  blog:     `<path d="M4 20h4l10.5 -10.5a2.828 2.828 0 1 0 -4 -4l-10.5 10.5v4"/><line x1="13.5" y1="6.5" x2="17.5" y2="10.5"/>`,
  list:     `<line x1="13" y1="6" x2="21" y2="6"/><line x1="13" y1="12" x2="21" y2="12"/><line x1="13" y1="18" x2="21" y2="18"/><line x1="4" y1="6" x2="6" y2="6"/><line x1="4" y1="12" x2="6" y2="12"/><line x1="4" y1="18" x2="6" y2="18"/>`,
  practice: `<path d="M9 5H7a2 2 0 0 0 -2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2V7a2 2 0 0 0 -2 -2h-2"/><rect x="9" y="3" width="6" height="4" rx="2"/><path d="M9 14l2 2 4 -4"/>`,
  x:        `<path d="M4 4l16 16"/><path d="M20 4L4 20"/>`,
  contrib:  `<circle cx="6" cy="6" r="2"/><circle cx="6" cy="18" r="2"/><circle cx="18" cy="18" r="2"/><path d="M6 8v8"/><path d="M11 6h5a2 2 0 0 1 2 2v8"/>`,
};
const linkSvg = (paths: string) => `<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${paths}</svg>`;
---

<Base
  title="Research on how humans must evolve to use AI well"
  description={description}
  jsonLd={jsonLd}
>

  {/* ─── Hero / header ─────────────────────────────────────────── */}
  <header class="mx-auto max-w-[1180px] px-6 pt-14 pb-10 reveal-stagger">
    <div class="grid lg:grid-cols-[200px_minmax(0,1fr)] gap-x-16 gap-y-8">

      <aside class="lg:border-r border-paper-300 dark:border-ink-600 lg:pr-6">
        <p class="meta-label">Index № 01</p>
        <p class="kicker mt-2 text-ink-700 dark:text-ink-50">v1 · {lastYear}</p>

        <dl class="mt-7 space-y-3 text-[12.5px]">
          <div>
            <dt class="meta-label">Entries</dt>
            <dd class="meta-value mt-0.5 tabular-nums">{paperCount}</dd>
          </div>
          <div>
            <dt class="meta-label">Phases</dt>
            <dd class="meta-value mt-0.5 tabular-nums">4 + 3 emerging</dd>
          </div>
        </dl>
      </aside>

      <div>
        <p class="heading-eyebrow">Human–AI Coevolution</p>

        <h1 class="kicker-xl mt-5 text-ink-700 dark:text-ink-50 max-w-[22ch]">
          How <em class="text-accent dark:text-accent-dark italic">humans must evolve</em> to use AI well as AI advances.
        </h1>

        <p class="mt-6 text-[14px] text-ink-600 dark:text-ink-200 leading-[1.7] max-w-[58ch]">
          <span class="font-medium text-ink-700 dark:text-ink-50">Xu Li</span>,
          <span class="font-medium text-ink-700 dark:text-ink-50">Simon Yu</span>,
          <span class="font-medium text-ink-700 dark:text-ink-50">Derek Chong</span>,
          <span class="font-medium text-ink-700 dark:text-ink-50">Bo Liu</span>,
          <span class="font-medium text-ink-700 dark:text-ink-50">Qianou Ma</span>,
          <span class="font-medium text-ink-700 dark:text-ink-50">Marwa Abdulhai</span>,
          <span class="font-medium text-ink-700 dark:text-ink-50">Diyi Yang</span>,
          <span class="font-medium text-ink-700 dark:text-ink-50">Tongshuang Wu</span>,
          <span class="font-medium text-ink-700 dark:text-ink-50">Hua Shen</span>,
          <span class="font-medium text-ink-700 dark:text-ink-50">Weiyan Shi</span>
        </p>
      </div>
    </div>
  </header>

  {/* ─── Inline link bar ───────────────────────────────────────── */}
  <nav
    class="mx-auto max-w-[1180px] px-6 reveal"
    aria-label="Project resources"
  >
    <div class="frame py-4">
      <div class="flex flex-wrap items-center gap-x-7 gap-y-3 text-[13.5px]">
        <a href="#" class="link-row"><Fragment set:html={linkSvg(ICONS.paper)} /><span>Paper</span></a>
        <span class="link-sep">·</span>
        <a href={`${base}/blog/`} class="link-row"><Fragment set:html={linkSvg(ICONS.blog)} /><span>Blog post</span></a>
        <span class="link-sep">·</span>
        <a href={`${base}/papers/`} class="link-row"><Fragment set:html={linkSvg(ICONS.list)} /><span>Paper index</span></a>
        <span class="link-sep">·</span>
        <a href="#" class="link-row"><Fragment set:html={linkSvg(ICONS.x)} /><span>X thread</span></a>
        <span class="link-sep">·</span>
        <a href={REPO_URL} target="_blank" rel="noopener" class="link-row"><Fragment set:html={linkSvg(ICONS.contrib)} /><span>Contribute</span></a>
      </div>
    </div>
  </nav>

  {/* ─── §01 Overview ──────────────────────────────────────────── */}
  <section class="mx-auto max-w-[1180px] px-6 mt-12 reveal">
    <div class="grid lg:grid-cols-[200px_minmax(0,1fr)] gap-x-16 gap-y-6">
      <div class="lg:border-r border-paper-300 dark:border-ink-600 lg:pr-6">
        <p class="meta-label">§01</p>
        <p class="kicker mt-2 text-ink-700 dark:text-ink-50">Overview</p>
      </div>
      <div class="max-w-[64ch] text-[15.5px] text-ink-700 dark:text-ink-100 leading-[1.78] space-y-5">
        <p>Human-AI coevolution is the process by which humans and AI systems shape each other over time. As humans delegate more work to AI, we need new skills, critical thinking, evaluative expertise, monitoring autonomous workflows, governing systems of agents, to use that work well. Without those skills, we lose our ability to direct AI even as it grows more capable. The better usage patterns humans develop also feed back as higher-quality signal for the AI we train next.</p>
        <p>This site brings together the four artifacts of that project: our position paper arguing that <strong class="text-ink-700 dark:text-ink-50">human evolution should be treated as an explicit goal</strong> of human-AI coevolution, a <a class="a-text" href={`${base}/blog/`}>plain-language blog companion</a>, a <a class="a-text" href={`${base}/papers/`}>curated index of {paperCount}+ research papers</a> organized by the four-phase framework, and concrete practices for humans to use AI well.</p>
      </div>
    </div>
  </section>

  {/* ─── §02 Framework visual block ────────────────────────────── */}
  <section class="mx-auto max-w-[1180px] px-6 mt-12 reveal">
    <div class="grid lg:grid-cols-[200px_minmax(0,1fr)] gap-x-16 gap-y-6">
      <div class="lg:border-r border-paper-300 dark:border-ink-600 lg:pr-6">
        <p class="meta-label">§02</p>
        <p class="kicker mt-2 text-ink-700 dark:text-ink-50">Framework</p>
        <p class="mt-3 text-[13px] text-ink-500 dark:text-ink-300 leading-relaxed max-w-[14em]">
          Four phases of how humans use AI, by how much they delegate.
        </p>
      </div>

      <div class="max-w-[64ch]">
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
          <div class="rounded-md bg-paper-200 dark:bg-ink-700/40 px-4 py-3.5">
            <p class="meta-label text-accent dark:text-accent-dark">Phase 1</p>
            <p class="kicker mt-1 text-[18px] text-ink-700 dark:text-ink-50">Tool</p>
          </div>
          <div class="rounded-md bg-paper-200 dark:bg-ink-700/40 px-4 py-3.5">
            <p class="meta-label text-accent dark:text-accent-dark">Phase 2</p>
            <p class="kicker mt-1 text-[18px] text-ink-700 dark:text-ink-50">Assistant</p>
          </div>
          <div class="rounded-md bg-paper-200 dark:bg-ink-700/40 px-4 py-3.5">
            <p class="meta-label text-accent dark:text-accent-dark">Phase 3</p>
            <p class="kicker mt-1 text-[18px] text-ink-700 dark:text-ink-50">Executor</p>
          </div>
          <div class="rounded-md bg-paper-200 dark:bg-ink-700/40 px-4 py-3.5">
            <p class="meta-label text-accent dark:text-accent-dark">Phase 4</p>
            <p class="kicker mt-1 text-[18px] text-ink-700 dark:text-ink-50">Organization</p>
          </div>
        </div>
        <p class="mt-3 text-[13px] text-ink-500 dark:text-ink-300 leading-relaxed">
          Humans use AI as a tool (knowledge queries), as an assistant (producing artifacts), as an executor (autonomous workflows), and as an organization (governing whole systems). Each phase demands a different human capability.
        </p>
      </div>
    </div>
  </section>

  {/* ─── §03 Three-item teaser ─────────────────────────────────── */}
  <section class="mx-auto max-w-[1180px] px-6 mt-12 reveal">
    <div class="grid lg:grid-cols-[200px_minmax(0,1fr)] gap-x-16 gap-y-6">
      <div class="lg:border-r border-paper-300 dark:border-ink-600 lg:pr-6">
        <p class="meta-label">§03</p>
        <p class="kicker mt-2 text-ink-700 dark:text-ink-50">Practice this week</p>
        <p class="mt-3 text-[13px] text-ink-500 dark:text-ink-300 leading-relaxed max-w-[14em]">
          Three habits to keep your underlying skills alive even as you delegate more work to AI. <a href={`${base}/blog/#sec-habits`} class="a-text">Read the full guide →</a>
        </p>
      </div>

      <div class="max-w-[64ch] grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="frame py-4 px-5">
          <p class="meta-label">Habit 01</p>
          <p class="kicker mt-1.5 text-[16px] text-ink-700 dark:text-ink-50">Pre-think</p>
          <p class="mt-1.5 text-[13.5px] text-ink-500 dark:text-ink-300 leading-relaxed">
            Before you ask, take ten seconds to note your initial guess at the answer. Then ask. Then compare.
          </p>
        </div>
        <div class="frame py-4 px-5">
          <p class="meta-label">Habit 02</p>
          <p class="kicker mt-1.5 text-[16px] text-ink-700 dark:text-ink-50">Prepare</p>
          <p class="mt-1.5 text-[13.5px] text-ink-500 dark:text-ink-300 leading-relaxed">
            Write test cases or success rubrics before integrating AI-generated results into real work.
          </p>
        </div>
        <div class="frame py-4 px-5">
          <p class="meta-label">Habit 03</p>
          <p class="kicker mt-1.5 text-[16px] text-ink-700 dark:text-ink-50">Disconnect</p>
          <p class="mt-1.5 text-[13.5px] text-ink-500 dark:text-ink-300 leading-relaxed">
            Once a week, do a task you usually delegate, entirely without AI.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* ─── §04 List section ──────────────────────────────────────── */}
  <section class="mx-auto max-w-[1180px] px-6 mt-12 reveal">
    <div class="grid lg:grid-cols-[200px_minmax(0,1fr)] gap-x-16 gap-y-6">
      <div class="lg:border-r border-paper-300 dark:border-ink-600 lg:pr-6">
        <p class="meta-label">§04</p>
        <p class="kicker mt-2 text-ink-700 dark:text-ink-50">Recently added</p>
        <p class="mt-3 text-[13px] text-ink-500 dark:text-ink-300 leading-relaxed max-w-[14em]">
          The newest entries across the four-phase index. <a href={`${base}/papers/`} class="a-text">View all {paperCount} →</a>
        </p>
      </div>

      <ol class="list-none p-0 max-w-[64ch]">
        {canonical.slice(0, 4).map((p) => (
          <li class="border-t border-paper-300 dark:border-ink-600 py-3 text-[14px] leading-relaxed">
            <a href={`${base}/papers/${p.slug}/`} class="a-text font-medium text-ink-700 dark:text-ink-50">{p.title}</a>
            <span class="ml-1.5 text-ink-500 dark:text-ink-300">— {p.authors[0]}{p.authors.length > 1 ? ' et al.' : ''}, {p.year}</span>
          </li>
        ))}
        <li><div class="border-t border-paper-300 dark:border-ink-600"></div></li>
      </ol>
    </div>
  </section>

  {/* ─── §05 Citation ──────────────────────────────────────────── */}
  <section class="mx-auto max-w-[1180px] px-6 mt-12 pb-16 reveal">
    <div class="grid lg:grid-cols-[200px_minmax(0,1fr)] gap-x-16 gap-y-6">
      <div class="lg:border-r border-paper-300 dark:border-ink-600 lg:pr-6">
        <p class="meta-label">§05</p>
        <p class="kicker mt-2 text-ink-700 dark:text-ink-50">Citation</p>
      </div>
      <div class="max-w-[64ch]">
<pre class="bibtex-block">@misc&lbrace;li2026human,
  title   = &lbrace;Human Evolution Should be Treated as a Goal in Human-AI Co-Evolution&rbrace;,
  author  = &lbrace;Xu Li and Simon Yu and Derek Chong and Bo Liu and Qianou Ma and Marwa Abdulhai
             and Diyi Yang and Tongshuang Wu and Hua Shen and Weiyan Shi&rbrace;,
  year    = &lbrace;2026&rbrace;,
  note    = &lbrace;Position paper, in preparation&rbrace;,
  url     = &lbrace;https://human-ai-coevolution.github.io/&rbrace;
&rbrace;</pre>
      </div>
    </div>
  </section>

</Base>

<style>
  .link-row {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: theme('colors.ink.700');
    text-decoration: none;
    transition: color 0.15s ease;
  }
  :global(html.dark) .link-row { color: theme('colors.ink.50'); }
  .link-row:hover { color: theme('colors.accent.DEFAULT'); }
  :global(html.dark) .link-row:hover { color: theme('colors.accent.dark'); }
  .link-row svg { color: theme('colors.ink.400'); transition: color 0.15s ease; }
  :global(html.dark) .link-row svg { color: theme('colors.ink.300'); }
  .link-row:hover svg { color: theme('colors.accent.DEFAULT'); }
  :global(html.dark) .link-row:hover svg { color: theme('colors.accent.dark'); }
  .link-sep {
    color: theme('colors.ink.300');
    user-select: none;
  }
  :global(html.dark) .link-sep { color: theme('colors.ink.500'); }

  .bibtex-block {
    margin: 0;
    background: theme('colors.paper.200');
    border: 1px solid theme('colors.paper.300');
    border-radius: 8px;
    padding: 1rem 1.1rem;
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.6;
    color: theme('colors.ink.700');
    overflow-x: auto;
    white-space: pre;
  }
  :global(html.dark) .bibtex-block {
    background: theme('colors.ink.800');
    border-color: theme('colors.ink.600');
    color: theme('colors.ink.100');
  }
</style>
