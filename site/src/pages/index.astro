---
import Base from '../layouts/Base.astro';
import { loadAllPapers } from '../lib/parsePapers';
import {
  SITE_TITLE,
  MAINTAINER_NAME,
  MAINTAINER_AFFILIATION,
  MAINTAINER_URL,
  REPO_URL,
} from '../lib/site';

const { canonical } = loadAllPapers();
const paperCount = canonical.length;
const lastYear = new Date().getFullYear();

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteOrigin = (Astro.site ?? new URL('https://human-ai-coevolution.github.io'))
  .toString()
  .replace(/\/$/, '');
const siteUrl = siteOrigin + base + '/';

const description = `A curated research index on human-AI coevolution: how humans must evolve to use AI well as AI advances. ${paperCount}+ papers organized by a four-phase framework (Tool, Assistant, Executor, Organization), a position paper, and a plain-language blog.`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': siteUrl + '#website',
    name: SITE_TITLE,
    url: siteUrl,
    description,
    inLanguage: 'en',
    potentialAction: {
      '@type': 'SearchAction',
      target: { '@type': 'EntryPoint', urlTemplate: `${siteOrigin}${base}/papers/?q={search_term_string}` },
      'query-input': 'required name=search_term_string',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Dataset',
    '@id': siteUrl + '#dataset',
    name: 'Human–AI Coevolution Paper Index',
    description: `A curated, openly maintained list of ${paperCount}+ research papers on how humans must evolve to use AI well as AI advances. Organized by a four-phase framework spanning Tool, Assistant, Executor, and Organization uses of AI.`,
    url: `${siteOrigin}${base}/papers/`,
    keywords: ['human-AI coevolution', 'human-AI collaboration', 'human-AI alignment', 'AI literacy', 'RLHF', 'mutual adaptation', 'longitudinal HCI', 'AI agents'],
    license: 'https://opensource.org/licenses/MIT',
    isAccessibleForFree: true,
    creator: { '@id': siteUrl + '#org' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': siteUrl + '#org',
    name: MAINTAINER_NAME,
    url: MAINTAINER_URL,
    parentOrganization: { '@type': 'EducationalOrganization', name: MAINTAINER_AFFILIATION },
  },
];

// Inline icons in the existing site's restrained style: thin stroke, currentColor.
const ICONS = {
  paper:    `<path d="M14 3v4a1 1 0 0 0 1 1h4"/><path d="M17 21H7a2 2 0 0 1 -2 -2V5a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2z"/><line x1="9" y1="13" x2="15" y2="13"/><line x1="9" y1="17" x2="13" y2="17"/>`,
  blog:     `<path d="M4 20h4l10.5 -10.5a2.828 2.828 0 1 0 -4 -4l-10.5 10.5v4"/><line x1="13.5" y1="6.5" x2="17.5" y2="10.5"/>`,
  list:     `<line x1="13" y1="6" x2="21" y2="6"/><line x1="13" y1="12" x2="21" y2="12"/><line x1="13" y1="18" x2="21" y2="18"/><line x1="4" y1="6" x2="6" y2="6"/><line x1="4" y1="12" x2="6" y2="12"/><line x1="4" y1="18" x2="6" y2="18"/>`,
  practice: `<path d="M9 5H7a2 2 0 0 0 -2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2V7a2 2 0 0 0 -2 -2h-2"/><rect x="9" y="3" width="6" height="4" rx="2"/><path d="M9 14l2 2 4 -4"/>`,
  x:        `<path d="M4 4l16 16"/><path d="M20 4L4 20"/>`,
  contrib:  `<circle cx="6" cy="6" r="2"/><circle cx="6" cy="18" r="2"/><circle cx="18" cy="18" r="2"/><path d="M6 8v8"/><path d="M11 6h5a2 2 0 0 1 2 2v8"/>`,
};
const linkSvg = (paths: string) => `<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${paths}</svg>`;
---

<Base
  description={description}
  jsonLd={jsonLd}
>

  {/* ─── Hero / header ─────────────────────────────────────────── */}
  <header class="mx-auto max-w-[1180px] px-6 pt-14 pb-10 reveal-stagger">
    <div class="grid lg:grid-cols-[200px_minmax(0,1fr)] gap-x-16 gap-y-8">

      <aside class="lg:border-r border-paper-300 dark:border-ink-600 lg:pr-6">
        <p class="meta-label">Index № 01</p>
        <p class="kicker mt-2 text-ink-700 dark:text-ink-50">{lastYear}</p>

        <dl class="mt-7 space-y-3 text-[12.5px]">
          <div>
            <dt class="meta-label">Entries</dt>
            <dd class="meta-value mt-0.5 tabular-nums">{paperCount}</dd>
          </div>
          <div>
            <dt class="meta-label">Phases</dt>
            <dd class="meta-value mt-0.5 tabular-nums">4 + 3 emerging</dd>
          </div>
        </dl>
      </aside>

      <div>
        <h1 class="kicker-xl text-ink-700 dark:text-ink-50 max-w-[22ch]">Human–AI Coevolution</h1>

        <p class="mt-6 text-[19px] text-ink-600 dark:text-ink-200 max-w-[42ch] leading-snug">
          How <em class="text-accent dark:text-accent-dark italic">humans must evolve</em> to use AI well as AI advances.
        </p>

        <p class="mt-6 text-[14px] text-ink-600 dark:text-ink-200 leading-[1.7] max-w-[58ch]">
          <a href="https://xuli0929.github.io/" target="_blank" rel="noopener" class="author-link">Xu Li</a>,
          <a href="https://simonucl.github.io/" target="_blank" rel="noopener" class="author-link">Simon Yu</a>,
          <a href="https://nlp.stanford.edu/~derekch/" target="_blank" rel="noopener" class="author-link">Derek Chong</a>,
          <a href="https://benjamin-eecs.github.io/" target="_blank" rel="noopener" class="author-link">Bo Liu</a>,
          <a href="https://qianouma.com/en/about.html" target="_blank" rel="noopener" class="author-link">Qianou Ma</a>,
          <a href="https://abdulhaim.github.io/" target="_blank" rel="noopener" class="author-link">Marwa Abdulhai</a>,
          <a href="https://cs.stanford.edu/~diyiy/" target="_blank" rel="noopener" class="author-link">Diyi Yang</a>,
          <a href="https://www.cs.cmu.edu/~sherryw/" target="_blank" rel="noopener" class="author-link">Tongshuang Wu</a>,
          <a href="https://hua-shen.org/" target="_blank" rel="noopener" class="author-link">Hua Shen</a>,
          <a href="https://wyshi.github.io/" target="_blank" rel="noopener" class="author-link">Weiyan Shi</a>
        </p>
      </div>
    </div>
  </header>

  {/* ─── Inline link bar ───────────────────────────────────────── */}
  <nav
    class="mx-auto max-w-[1180px] px-6 reveal"
    aria-label="Project resources"
  >
    <div class="frame py-4">
      <div class="flex flex-wrap items-center gap-x-7 gap-y-3 text-[13.5px]">
        <a href="#" class="link-row"><Fragment set:html={linkSvg(ICONS.paper)} /><span>Paper</span></a>
        <span class="link-sep">·</span>
        <a href={`${base}/blog/`} class="link-row"><Fragment set:html={linkSvg(ICONS.blog)} /><span>Blog post</span></a>
        <span class="link-sep">·</span>
        <a href={`${base}/papers/`} class="link-row"><Fragment set:html={linkSvg(ICONS.list)} /><span>Paper index</span></a>
        <span class="link-sep">·</span>
        <a href="#" class="link-row"><Fragment set:html={linkSvg(ICONS.x)} /><span>X thread</span></a>
        <span class="link-sep">·</span>
        <a href={REPO_URL} target="_blank" rel="noopener" class="link-row"><Fragment set:html={linkSvg(ICONS.contrib)} /><span>Contribute</span></a>
      </div>
    </div>
  </nav>

  {/* ─── §01 Overview ──────────────────────────────────────────── */}
  <section class="mx-auto max-w-[1180px] px-6 mt-12 reveal">
    <div class="grid lg:grid-cols-[200px_minmax(0,1fr)] gap-x-16 gap-y-6">
      <div class="lg:border-r border-paper-300 dark:border-ink-600 lg:pr-6">
        <p class="meta-label">§01</p>
        <p class="kicker mt-2 text-ink-700 dark:text-ink-50">Overview</p>
      </div>
      <div class="max-w-[64ch] text-[15.5px] text-ink-700 dark:text-ink-100 leading-[1.78]">
        <p>Human-AI coevolution is the process by which humans and AI systems shape each other over time. However, most of the work overlooks the evolution of the human side, either treating it as a means to better AI or just ignoring it. We argue that "<a class="a-text" href={`${base}/blog/`}>Human Evolution Must Be Treated as a Goal in Human-AI Coevolution</a>" in order to better utilize AI as it advances, while the higher-quality feedback also drives better AI development. Building on what AI can do, we propose a four-phase framework defined by how much work humans delegate to AI. Based on this framework, we collect <a class="a-text" href={`${base}/papers/`}>{paperCount} awesome works</a>, categorized by the roles of AI and humans in the working system.</p>
      </div>
    </div>
  </section>

  {/* ─── §02 Framework visual block ────────────────────────────── */}
  <section class="mx-auto max-w-[1180px] px-6 mt-12 reveal">
    <div class="grid lg:grid-cols-[200px_minmax(0,1fr)] gap-x-16 gap-y-6">
      <div class="lg:border-r border-paper-300 dark:border-ink-600 lg:pr-6">
        <p class="meta-label">§02</p>
        <p class="kicker mt-2 text-ink-700 dark:text-ink-50">Framework</p>
        <p class="mt-3 text-[13px] text-ink-500 dark:text-ink-300 leading-relaxed max-w-[14em]">
          Four phases of how humans use AI, by how much they delegate. Select a phase to see what it asks of you.
        </p>
      </div>

      <div class="max-w-[64ch]" id="phase-framework">
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3" role="tablist" aria-label="Four-phase framework">
          <button type="button" role="tab" data-phase="1" id="phase-tab-1" aria-controls="phase-panel-1" aria-selected="true" class="phase-card rounded-md bg-paper-200 dark:bg-ink-700/40 hover:bg-paper-300 dark:hover:bg-ink-700/70 px-4 py-3.5 text-left w-full h-full transition-colors">
            <span class="meta-label block text-accent dark:text-accent-dark">Phase 1</span>
            <span class="phase-name mt-1 block text-[16px] font-medium tracking-tight text-ink-700 dark:text-ink-50">Tool</span>
          </button>
          <button type="button" role="tab" data-phase="2" id="phase-tab-2" aria-controls="phase-panel-2" aria-selected="false" class="phase-card rounded-md bg-paper-200 dark:bg-ink-700/40 hover:bg-paper-300 dark:hover:bg-ink-700/70 px-4 py-3.5 text-left w-full h-full transition-colors">
            <span class="meta-label block text-accent dark:text-accent-dark">Phase 2</span>
            <span class="phase-name mt-1 block text-[16px] font-medium tracking-tight text-ink-700 dark:text-ink-50">Assistant</span>
          </button>
          <button type="button" role="tab" data-phase="3" id="phase-tab-3" aria-controls="phase-panel-3" aria-selected="false" class="phase-card rounded-md bg-paper-200 dark:bg-ink-700/40 hover:bg-paper-300 dark:hover:bg-ink-700/70 px-4 py-3.5 text-left w-full h-full transition-colors">
            <span class="meta-label block text-accent dark:text-accent-dark">Phase 3</span>
            <span class="phase-name mt-1 block text-[16px] font-medium tracking-tight text-ink-700 dark:text-ink-50">Executor</span>
          </button>
          <button type="button" role="tab" data-phase="4" id="phase-tab-4" aria-controls="phase-panel-4" aria-selected="false" class="phase-card rounded-md bg-paper-200 dark:bg-ink-700/40 hover:bg-paper-300 dark:hover:bg-ink-700/70 px-4 py-3.5 text-left w-full h-full transition-colors">
            <span class="meta-label block text-accent dark:text-accent-dark">Phase 4</span>
            <span class="phase-name mt-1 block text-[16px] font-medium tracking-tight text-ink-700 dark:text-ink-50">Organization</span>
          </button>
        </div>

        <div class="mt-3 min-h-[104px] sm:min-h-[80px]">
          <div class="phase-panel" id="phase-panel-1" data-panel="1" role="tabpanel" aria-labelledby="phase-tab-1">
            <p class="text-[13.5px] text-ink-600 dark:text-ink-200 leading-relaxed">
              <strong class="font-medium text-ink-700 dark:text-ink-50">Knowledge queries.</strong> AI answers; the human still does the work. Demands <strong class="font-medium text-ink-700 dark:text-ink-50">critical thinking</strong>: predict the answer before you ask, so AI sharpens your reasoning instead of replacing it.
            </p>
          </div>
          <div class="phase-panel" id="phase-panel-2" data-panel="2" role="tabpanel" aria-labelledby="phase-tab-2" hidden>
            <p class="text-[13.5px] text-ink-600 dark:text-ink-200 leading-relaxed">
              <strong class="font-medium text-ink-700 dark:text-ink-50">Produced artifacts.</strong> AI drafts; the human verifies and ships. Demands <strong class="font-medium text-ink-700 dark:text-ink-50">evaluative expertise</strong>: decide what an output must pass before you rely on it.
            </p>
          </div>
          <div class="phase-panel" id="phase-panel-3" data-panel="3" role="tabpanel" aria-labelledby="phase-tab-3" hidden>
            <p class="text-[13.5px] text-ink-600 dark:text-ink-200 leading-relaxed">
              <strong class="font-medium text-ink-700 dark:text-ink-50">Autonomous workflows.</strong> AI runs whole tasks end to end; the human sets goals and supervises. Demands <strong class="font-medium text-ink-700 dark:text-ink-50">metacognitive monitoring</strong>: choose where to check in before the work runs.
            </p>
          </div>
          <div class="phase-panel" id="phase-panel-4" data-panel="4" role="tabpanel" aria-labelledby="phase-tab-4" hidden>
            <p class="text-[13.5px] text-ink-600 dark:text-ink-200 leading-relaxed">
              <strong class="font-medium text-ink-700 dark:text-ink-50">Governed systems.</strong> AI coordinates whole systems of agents; the human governs. Demands <strong class="font-medium text-ink-700 dark:text-ink-50">systems thinking</strong>: set the rules up front, then audit samples of what the system does.
            </p>
          </div>
        </div>

        <p class="mt-3 text-[12.5px] text-ink-400 dark:text-ink-300">
          Each phase demands a different human capability. <a class="a-text" href={`${base}/blog/#sec-phases`}>See the full breakdown →</a>
        </p>
      </div>
    </div>
  </section>

  {/* ─── §03 Three-item teaser ─────────────────────────────────── */}
  <section class="mx-auto max-w-[1180px] px-6 mt-12 reveal">
    <div class="grid lg:grid-cols-[200px_minmax(0,1fr)] gap-x-16 gap-y-6">
      <div class="lg:border-r border-paper-300 dark:border-ink-600 lg:pr-6">
        <p class="meta-label">§03</p>
        <p class="kicker mt-2 text-ink-700 dark:text-ink-50">Practice this week</p>
        <p class="mt-3 text-[13px] text-ink-500 dark:text-ink-300 leading-relaxed max-w-[14em]">
          Three habits to keep your underlying skills alive even as you delegate more work to AI. <a href={`${base}/blog/#sec-habits`} class="a-text">Read the full guide →</a>
        </p>
      </div>

      <div class="max-w-[64ch] grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="frame py-4 px-5">
          <p class="meta-label">Habit 01</p>
          <p class="kicker mt-1.5 text-[16px] text-ink-700 dark:text-ink-50">Pre-think</p>
          <p class="mt-1.5 text-[13.5px] text-ink-500 dark:text-ink-300 leading-relaxed">
            Before you ask, take ten seconds to note your initial guess at the answer. Then ask. Then compare.
          </p>
        </div>
        <div class="frame py-4 px-5">
          <p class="meta-label">Habit 02</p>
          <p class="kicker mt-1.5 text-[16px] text-ink-700 dark:text-ink-50">Prepare</p>
          <p class="mt-1.5 text-[13.5px] text-ink-500 dark:text-ink-300 leading-relaxed">
            Write test cases or success rubrics before integrating AI-generated results into real work.
          </p>
        </div>
        <div class="frame py-4 px-5">
          <p class="meta-label">Habit 03</p>
          <p class="kicker mt-1.5 text-[16px] text-ink-700 dark:text-ink-50">Disconnect</p>
          <p class="mt-1.5 text-[13.5px] text-ink-500 dark:text-ink-300 leading-relaxed">
            Once a week, do a task you usually delegate, entirely without AI.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* ─── §04 List section ──────────────────────────────────────── */}
  <section class="mx-auto max-w-[1180px] px-6 mt-12 reveal">
    <div class="grid lg:grid-cols-[200px_minmax(0,1fr)] gap-x-16 gap-y-6">
      <div class="lg:border-r border-paper-300 dark:border-ink-600 lg:pr-6">
        <p class="meta-label">§04</p>
        <p class="kicker mt-2 text-ink-700 dark:text-ink-50">Recently added</p>
        <p class="mt-3 text-[13px] text-ink-500 dark:text-ink-300 leading-relaxed max-w-[14em]">
          The newest entries across the four-phase index. <a href={`${base}/papers/`} class="a-text">View all {paperCount} →</a>
        </p>
      </div>

      <ol class="list-none p-0 max-w-[64ch]">
        {canonical.slice(0, 4).map((p) => (
          <li class="border-t border-paper-300 dark:border-ink-600 py-3 text-[14px] leading-relaxed">
            <a href={`${base}/papers/${p.slug}/`} class="a-text font-medium text-ink-700 dark:text-ink-50">{p.title}</a>
            <span class="ml-1.5 text-ink-500 dark:text-ink-300">— {p.authors[0]}{p.authors.length > 1 ? ' et al.' : ''}, {p.year}</span>
          </li>
        ))}
        <li><div class="border-t border-paper-300 dark:border-ink-600"></div></li>
      </ol>
    </div>
  </section>

  {/* ─── §05 Citation ──────────────────────────────────────────── */}
  <section class="mx-auto max-w-[1180px] px-6 mt-12 pb-16 reveal">
    <div class="grid lg:grid-cols-[200px_minmax(0,1fr)] gap-x-16 gap-y-6">
      <div class="lg:border-r border-paper-300 dark:border-ink-600 lg:pr-6">
        <p class="meta-label">§05</p>
        <p class="kicker mt-2 text-ink-700 dark:text-ink-50">Citation</p>
      </div>
      <div class="max-w-[64ch]">
<pre class="bibtex-block">@misc&lbrace;li2026human,
  title   = &lbrace;Human Evolution Should be Treated as a Goal in Human-AI Co-Evolution&rbrace;,
  author  = &lbrace;Xu Li and Simon Yu and Derek Chong and Bo Liu and Qianou Ma and Marwa Abdulhai
             and Diyi Yang and Tongshuang Wu and Hua Shen and Weiyan Shi&rbrace;,
  year    = &lbrace;2026&rbrace;,
  note    = &lbrace;Position paper, in preparation&rbrace;,
  url     = &lbrace;https://human-ai-coevolution.github.io/&rbrace;
&rbrace;</pre>
      </div>
    </div>
  </section>

</Base>

<script>
  // §02 — clickable four-phase selector. Each tab reveals its panel
  // with a short fade. Re-initialised on view-transition navigation.
  function initPhaseFramework() {
    const root = document.getElementById('phase-framework');
    if (!root) return;
    const tabs = [...root.querySelectorAll<HTMLElement>('[data-phase]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];

    function select(n: string, focus = false) {
      for (const t of tabs) t.setAttribute('aria-selected', String(t.dataset.phase === n));
      for (const p of panels) {
        const on = p.dataset.panel === n;
        p.hidden = !on;
        if (on) {
          p.classList.remove('phase-panel--in');
          void p.offsetWidth; // restart the animation
          p.classList.add('phase-panel--in');
        }
      }
      if (focus) tabs.find((t) => t.dataset.phase === n)?.focus();
    }

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab.dataset.phase!));
      tab.addEventListener('keydown', (e) => {
        let j: number | null = null;
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') j = (i + 1) % tabs.length;
        else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') j = (i - 1 + tabs.length) % tabs.length;
        else if (e.key === 'Home') j = 0;
        else if (e.key === 'End') j = tabs.length - 1;
        if (j !== null) {
          e.preventDefault();
          select(tabs[j].dataset.phase!, true);
        }
      });
    });
  }
  document.addEventListener('astro:page-load', initPhaseFramework);
</script>

<style>
  .link-row {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: theme('colors.ink.700');
    text-decoration: none;
    transition: color 0.15s ease;
  }
  :global(html.dark) .link-row { color: theme('colors.ink.50'); }
  .link-row:hover { color: theme('colors.accent.DEFAULT'); }
  :global(html.dark) .link-row:hover { color: theme('colors.accent.dark'); }
  .link-row svg { color: theme('colors.ink.400'); transition: color 0.15s ease; }
  :global(html.dark) .link-row svg { color: theme('colors.ink.300'); }
  .link-row:hover svg { color: theme('colors.accent.DEFAULT'); }
  :global(html.dark) .link-row:hover svg { color: theme('colors.accent.dark'); }
  .link-sep {
    color: theme('colors.ink.300');
    user-select: none;
  }
  :global(html.dark) .link-sep { color: theme('colors.ink.500'); }

  .bibtex-block {
    margin: 0;
    background: theme('colors.paper.200');
    border: 1px solid theme('colors.paper.300');
    border-radius: 8px;
    padding: 1rem 1.1rem;
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.6;
    color: theme('colors.ink.700');
    overflow-x: auto;
    white-space: pre;
  }
  :global(html.dark) .bibtex-block {
    background: theme('colors.ink.800');
    border-color: theme('colors.ink.600');
    color: theme('colors.ink.100');
  }

  /* §02 — interactive four-phase selector */
  .phase-card {
    border: 1px solid transparent;
    cursor: pointer;
  }
  .phase-card[aria-selected='true'] {
    border-color: theme('colors.accent.DEFAULT');
  }
  :global(html.dark) .phase-card[aria-selected='true'] {
    border-color: theme('colors.accent.dark');
  }
  .phase-card[aria-selected='true'] .phase-name {
    color: theme('colors.accent.DEFAULT');
  }
  :global(html.dark) .phase-card[aria-selected='true'] .phase-name {
    color: theme('colors.accent.dark');
  }
  .phase-card:focus-visible {
    outline: 2px solid theme('colors.accent.DEFAULT');
    outline-offset: 2px;
  }

  @keyframes phase-fade {
    from { opacity: 0; transform: translateY(3px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .phase-panel--in { animation: phase-fade 0.28s ease both; }
  @media (prefers-reduced-motion: reduce) {
    .phase-panel--in { animation: none; }
  }

  /* Byline author links — read as plain bold names, reveal on hover */
  .author-link {
    color: theme('colors.ink.700');
    font-weight: 500;
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .author-link:hover {
    color: theme('colors.accent.DEFAULT');
    text-decoration: underline;
