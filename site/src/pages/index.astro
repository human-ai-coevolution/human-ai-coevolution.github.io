---
import Base from '../layouts/Base.astro';
import PhaseFlow from '../components/PhaseFlow.astro';
import { loadAllPapers } from '../lib/parsePapers';
import {
  SITE_TITLE,
  MAINTAINER_NAME,
  MAINTAINER_AFFILIATION,
  MAINTAINER_URL,
  PAPERS_INDEX_URL,
  PAPERS_REPO_URL,
} from '../lib/site';

const { canonical } = loadAllPapers();
const paperCount = canonical.length;
const lastYear = new Date().getFullYear();

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Four-phase filter cards under the §02 diagram. Each links into the
// paper index filtered by phase.
const phaseCount = (tag: string) => canonical.filter((p) => p.phase === tag).length;
const phaseCards = [
  { code: 'P1', name: 'Tool',         tag: 'phase-1' },
  { code: 'P2', name: 'Assistant',    tag: 'phase-2' },
  { code: 'P3', name: 'Executor',     tag: 'phase-3' },
  { code: 'P4', name: 'Organization', tag: 'phase-4' },
].map((c) => ({ ...c, count: phaseCount(c.tag) }));
const siteOrigin = (Astro.site ?? new URL('https://human-ai-coevolution.github.io'))
  .toString()
  .replace(/\/$/, '');
const siteUrl = siteOrigin + base + '/';

const description = `A curated research index on human-AI coevolution: how humans must evolve to use AI well as AI advances. ${paperCount}+ papers organized by a four-phase framework (Tool, Assistant, Executor, Organization), a position paper, and a plain-language blog.`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': siteUrl + '#website',
    name: SITE_TITLE,
    url: siteUrl,
    description,
    inLanguage: 'en',
    potentialAction: {
      '@type': 'SearchAction',
      target: { '@type': 'EntryPoint', urlTemplate: `${siteOrigin}${base}/papers/?q={search_term_string}` },
      'query-input': 'required name=search_term_string',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Dataset',
    '@id': siteUrl + '#dataset',
    name: 'Human–AI Coevolution Paper Index',
    description: `A curated, openly maintained list of ${paperCount}+ research papers on how humans must evolve to use AI well as AI advances. Organized by a four-phase framework spanning Tool, Assistant, Executor, and Organization uses of AI.`,
    url: `${siteOrigin}${base}/papers/`,
    keywords: ['human-AI coevolution', 'human-AI collaboration', 'human-AI alignment', 'AI literacy', 'RLHF', 'mutual adaptation', 'longitudinal HCI', 'AI agents'],
    license: 'https://opensource.org/licenses/MIT',
    isAccessibleForFree: true,
    creator: { '@id': siteUrl + '#org' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': siteUrl + '#org',
    name: MAINTAINER_NAME,
    url: MAINTAINER_URL,
    parentOrganization: { '@type': 'EducationalOrganization', name: MAINTAINER_AFFILIATION },
  },
];

---

<Base
  titleOverride="Human–AI Coevolution"
  description={description}
  jsonLd={jsonLd}
>

  {/* Single centered column — every section shares the same container, so
      the left/right space is identical from the hero to the citation. */}

  {/* ─── Hero / header — eyebrow + big statement title, after
      GUI-Agents-Paper-List's "A curated paper list / Research on GUI
      agents, kept up to date and easy to search." pattern ─────────── */}
  <header class="mx-auto max-w-[960px] px-6 pt-14 pb-2 reveal-stagger">
    <p class="meta-label flex items-center gap-3.5 text-[16px]">
      <span class="inline-block w-9 h-[2.5px] bg-accent dark:bg-accent-dark"></span>
      Human–AI Coevolution
    </p>

    <h1 class="mt-5 font-display font-medium text-[clamp(2.3rem,4.6vw,3.7rem)] leading-[1.12] tracking-[-0.012em] text-ink-700 dark:text-ink-50 max-w-[24ch]">
      How <em class="text-accent dark:text-accent-dark italic">humans must evolve</em> to use AI well as AI advances.
    </h1>

    {/* CTA pair, after the OSU hero's "Browse all papers / View stats" */}
    <div class="mt-9 flex flex-wrap items-center gap-3.5">
      <a
        href={`${base}/blog/`}
        class="inline-flex items-center gap-2 rounded-[9px] bg-accent dark:bg-accent-dark px-4 py-2.5 font-mono font-semibold text-[12.5px] uppercase tracking-[0.12em] text-paper-50 dark:text-nightbg hover:bg-accent/85 dark:hover:bg-accent-dark/85 transition-colors"
      >
        Read our position <span aria-hidden="true">→</span>
      </a>
      <a
        href={`${PAPERS_INDEX_URL}/`}
        class="inline-flex items-center gap-2 rounded-[9px] border border-accent dark:border-accent-dark px-4 py-2.5 font-mono font-semibold text-[12.5px] uppercase tracking-[0.12em] text-accent dark:text-accent-dark hover:bg-accent hover:text-paper-50 dark:hover:bg-accent-dark dark:hover:text-nightbg transition-colors"
      >
        Browse awesome papers <span aria-hidden="true">→</span>
      </a>
    </div>
  </header>

  {/* ─── §01 Overview (brief) ──────────────────────────────────── */}
  <section class="mx-auto max-w-[960px] px-6 mt-9 reveal">
    <p class="meta-label section-no">§01 · Overview</p>
    <div class="mt-4 text-[17px] text-ink-700 dark:text-ink-100 leading-[1.78]">
      <p>Most work on AI focuses on making the model smarter. We argue the human side must evolve too, and that <a class="a-text" href={`${base}/blog/`}>human evolution should be treated as a goal of human-AI coevolution</a>, not just a means to better AI. We map four phases of how we use AI and collect <a class="a-text" href={`${PAPERS_INDEX_URL}/`}>{paperCount} works</a> across them.</p>
    </div>
  </section>

  {/* ─── §02 Framework — two-sided conversation ────────────────── */}
  <section class="mx-auto max-w-[960px] px-6 mt-14 reveal">
    <p class="meta-label section-no">§02 · Framework</p>
    <p class="mt-4 text-[16px] text-ink-500 dark:text-ink-300 leading-relaxed">
      Four phases of how humans use AI, by how much they delegate. Scroll to watch the human role recede as AI takes on more.
    </p>

    <div class="mt-8">
      <PhaseFlow phaseCards={phaseCards} />
    </div>
  </section>

  {/* ─── §03 Citation ──────────────────────────────────────────── */}
  <section class="mx-auto max-w-[960px] px-6 mt-14 pb-16 reveal">
    <p class="meta-label section-no">§03 · Citation</p>
    <div class="mt-4">
<pre class="bibtex-block">@misc&lbrace;li2026human,
  title   = &lbrace;Human Evolution Should be Treated as a Goal in Human-AI Co-Evolution&rbrace;,
  author  = &lbrace;Xu Li and Simon Yu and Derek Chong and Bo Liu and Qianou Ma and Marwa Abdulhai
             and Diyi Yang and Tongshuang Wu and Hua Shen and Weiyan Shi&rbrace;,
  year    = &lbrace;2026&rbrace;,
  note    = &lbrace;Position paper, in preparation&rbrace;,
  url     = &lbrace;https://human-ai-coevolution.github.io/&rbrace;
&rbrace;</pre>
    </div>
  </section>

</Base>

<style>
  .bibtex-block {
    margin: 0;
    background: theme('colors.paper.200');
    border: 1px solid theme('colors.paper.300');
    border-radius: 8px;
    padding: 1rem 1.1rem;
    font-family: var(--font-mono);
    font-size: 13.5px;
    line-height: 1.6;
    color: theme('colors.ink.700');
    overflow-x: auto;
    white-space: pre;
  }
  :global(html.dark) .bibtex-block {
    background: theme('colors.ink.800');
    border-color: theme('colors.ink.600');
    color: theme('colors.ink.100');
  }

  /* Byline author links — read as plain bold names, reveal on hover */
  .author-link {
    color: theme('colors.ink.700');
    font-weight: 500;
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .author-link:hover {
    color: theme('colors.accent.DEFAULT');
    text-decoration: underline;
    text-underline-offset: 2px;
    text-decoration-thickness: 1px;
  }
  :global(html.dark) .author-link { color: theme('colors.ink.50'); }
  :global(html.dark) .author-link:hover { color: theme('colors.accent.dark'); }
</style>
