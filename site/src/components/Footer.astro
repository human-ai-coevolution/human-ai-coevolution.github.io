---
import { MAINTAINER_NAME, MAINTAINER_AFFILIATION, MAINTAINER_URL } from '../lib/site';
const year = new Date().getFullYear();
---
<footer class="mt-28 border-t border-paper-300 dark:border-ink-600">
  <div class="mx-auto max-w-[960px] px-6 py-8 text-[12.5px] font-mono uppercase tracking-[0.1em] text-ink-400 dark:text-ink-300">
    <p class="normal-case tracking-normal text-[13.5px] font-sans text-ink-500 dark:text-ink-300 mb-3">
      <span class="font-mono text-[12px] uppercase tracking-[0.1em] text-ink-400 dark:text-ink-300 mr-2">Authors:</span>
      <a href="https://xuli0929.github.io/" target="_blank" rel="noopener" class="author-link">Xu Li</a>,
      <a href="https://simonucl.github.io/" target="_blank" rel="noopener" class="author-link">Simon Yu</a>,
      <a href="https://nlp.stanford.edu/~derekch/" target="_blank" rel="noopener" class="author-link">Derek Chong</a>,
      <a href="https://benjamin-eecs.github.io/" target="_blank" rel="noopener" class="author-link">Bo Liu</a>,
      <a href="https://qianouma.com/en/about.html" target="_blank" rel="noopener" class="author-link">Qianou Ma</a>,
      <a href="https://abdulhaim.github.io/" target="_blank" rel="noopener" class="author-link">Marwa Abdulhai</a>,
      <a href="https://cs.stanford.edu/~diyiy/" target="_blank" rel="noopener" class="author-link">Diyi Yang</a>,
      <a href="https://www.cs.cmu.edu/~sherryw/" target="_blank" rel="noopener" class="author-link">Tongshuang Wu</a>,
      <a href="https://hua-shen.org/" target="_blank" rel="noopener" class="author-link">Hua Shen</a>,
      <a href="https://wyshi.github.io/" target="_blank" rel="noopener" class="author-link">Weiyan Shi</a>
    </p>
    <div class="flex flex-col sm:flex-row items-baseline gap-2 justify-between">
      <div>© {year} <a class="hover:text-accent dark:hover:text-accent-dark transition-colors" href={MAINTAINER_URL} target="_blank" rel="noopener">{MAINTAINER_NAME}</a>, {MAINTAINER_AFFILIATION}</div>
      <div>Open-source · MIT-licensed · Generated with Astro</div>
    </div>
    <p class="mt-3 normal-case tracking-normal text-[13px] font-sans text-ink-400 dark:text-ink-300 max-w-[64ch]">
      Some of the design and scaffolding here is adapted from <a class="hover:text-accent dark:hover:text-accent-dark transition-colors underline underline-offset-[3px] decoration-paper-300 dark:decoration-ink-600 hover:decoration-accent dark:hover:decoration-accent-dark" href="https://github.com/OSU-NLP-Group/GUI-Agents-Paper-List" target="_blank" rel="noopener">OSU-NLP-Group/GUI-Agents-Paper-List</a>. Thanks for their awesome work!
    </p>
  </div>
</footer>

<style>
  /* Author byline — plain medium names, accent on hover */
  .author-link {
    color: theme('colors.ink.600');
    font-weight: 500;
    text-decoration: none;
    transition: color 0.15s ease;
  }
  :global(html.dark) .author-link { color: theme('colors.ink.200'); }
  .author-link:hover {
    color: theme('colors.accent.DEFAULT');
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  :global(html.dark) .author-link:hover { color: theme('colors.accent.dark'); }
</style>
